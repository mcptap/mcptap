{
  "name": "@mcptap/vitest",
  "version": "0.1.0",
  "description": "Vitest matchers for mcptap. `await expect(server).toListTool('foo')` and friends.",
  "license": "MIT",
  "author": "Joan Cornudella",
  "homepage": "https://github.com/mcptap/mcptap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcptap/mcptap.git",
    "directory": "packages/vitest"
  },
  "bugs": {
    "url": "https://github.com/mcptap/mcptap/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "vitest",
    "vitest-matchers",
    "typescript",
    "mcptap"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "dependencies": {
    "@mcptap/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "^4.1.6"
  }
}
