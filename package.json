{
  "name": "mcptap",
  "private": true,
  "version": "0.0.0",
  "description": "Vitest, but it knows about MCP — test harness for Model Context Protocol servers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
